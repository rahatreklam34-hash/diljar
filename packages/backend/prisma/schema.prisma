// FinansTakip SaaS - Prisma Şeması
// PostgreSQL, çok kiracılı (multi-tenant) shared-DB + row-level (tenantId)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
//  PLATFORM / SAAS TABLOLARI
// ─────────────────────────────────────────────

enum UserRole {
  TENANT_OWNER
  TENANT_USER
}

enum TicketStatus {
  OPEN
  ANSWERED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Tenant {
  id            String       @id @default(cuid())
  name          String
  phone         String?
  seqNo         Int          @default(0)
  seqYil        Int?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  users         User[]
  tickets       SupportTicket[]
  auditLogs     AuditLog[]
  uploads       Upload[]
  integrations  IntegrationSetting[]
  productCategories ProductCategory[]
  markalar      Marka[]
  products      Product[]
  productVariations ProductVariation[]
  salesCodes    SalesCode[]
  importJobs    ImportJob[]
  customers     Customer[]
  discountCodes DiscountCode[]
  storeOrders   StoreOrder[]
  bankImportRows BankImportRow[]
  customCatalogs CustomCatalog[]
  storeSetting  StoreSetting?
  variationTemplates VariationTemplate[]
  liveStreams   LiveStream[]
  liveOrders    LiveOrder[]
  freeStreams   FreeStream[]
  freeOrders    FreeOrder[]
  freeProducts  FreeProduct[]
  suppliers     Supplier[]
  supplierPayments SupplierPayment[]
  botConfig     BotConfig?
  botKnowledge  BotKnowledge[]
  botGaps       BotGap[]
  chatSessions  ChatSession[]
  chatMessages  ChatMessage[]
  destekTalepleri DestekTalebi[]

  // Uygulama verileri
  cariHesaplar       CariHesap[]
  cariHareketler     CariHareket[]
  hareketler         Hareket[]
  kasaBanka          KasaBanka[]
  krediKartlari      KrediKarti[]
  birikimHesaplari   BirikimHesabi[]
  cekler             Cek[]
  personeller        Personel[]
  personelHareketler PersonelHareket[]
  duzenliOdemeler    DuzenliOdeme[]
  emanetParalar      EmanetPara[]
  hedefler           Hedef[]
  sistemLoglari      SistemLog[]
  sosyalHesaplar     SosyalHesap[]
  sosyalGruplar      SosyalGrup[]
  sosyalPersonalar   SosyalPersona[]
  igOtoYanitKurallar IgOtoYanitKural[]
  igOtoAyar          IgOtoAyar?
  igMesajLoglari     IgMesajLog[]
  cihazlar           Cihaz[]
  cihazGruplar       CihazGrup[]
  cihazGorevler      CihazGorev[]
  cihazGorevSonuclar CihazGorevSonuc[]
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  fullName      String
  role          UserRole @default(TENANT_OWNER)
  unvan         String?
  permissions   Json?
  prefs         Json?
  aktif         Boolean  @default(true)
  emailVerified Boolean  @default(false)
  tenantId      String?
  tenant        Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  ticketMessages TicketMessage[]

  @@index([tenantId])
}

model SupportTicket {
  id        String         @id @default(cuid())
  tenantId  String
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  subject   String
  category  String         @default("genel") // teknik | fatura | genel
  priority  TicketPriority @default(MEDIUM)
  status    TicketStatus   @default(OPEN)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  messages TicketMessage[]

  @@index([tenantId])
  @@index([status])
}

model TicketMessage {
  id           String        @id @default(cuid())
  ticketId     String
  ticket       SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderUserId String
  sender       User          @relation(fields: [senderUserId], references: [id])
  content      String
  isAdmin      Boolean       @default(false)
  attachments  Json?
  createdAt    DateTime      @default(now())

  @@index([ticketId])
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String?
  userName  String?
  action    String
  entity    String
  entityId  String?
  detail    String?
  hedef     String?
  kime      String?
  neden     String?
  ip        String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([entity])
  @@index([tenantId, createdAt])
}

model Upload {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fileName     String
  originalName String
  mimeType     String
  size         Int
  path         String
  category     String   @default("genel")
  createdByUserId String?
  createdAt    DateTime @default(now())

  @@index([tenantId])
}

model IntegrationSetting {
  id        String   @id @default(cuid())
  scope     String   @default("TENANT") // PLATFORM | TENANT
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category  String   // PAYMENT | CARGO
  provider  String   // paytr, iyzico, yurtici, aras, surat, dhl
  enabled   Boolean  @default(false)
  mode      String   @default("TEST") // TEST | LIVE
  config    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([scope, tenantId, provider])
  @@index([tenantId])
}

// ─────────────────────────────────────────────
//  UYGULAMA TABLOLARI (her biri tenantId ile izole)
// ─────────────────────────────────────────────

model CariHesap {
  id               String   @id @default(cuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ad               String
  bakiye           Float    @default(0)
  paraCinsi        String   @default("TRY")
  telefon          String?
  email            String?
  adres            String?
  sonHareketTarihi String?
  createdBy        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  hareketler CariHareket[]

  @@index([tenantId])
}

model CariHareket {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cariHesapId String
  cariHesap   CariHesap @relation(fields: [cariHesapId], references: [id], onDelete: Cascade)
  tarih       String
  saat        String
  aciklama    String
  tutar       Float
  tip         String // alis_fatura | satis_fatura | odeme | tahsilat | iade_al | iade_ver
  cekId       String?
  createdBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([tenantId])
  @@index([cariHesapId])
  @@index([cekId])
}

model Hareket {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tarih       String
  saat        String
  aciklama    String
  tutar       Float
  tip         String // gelir | gider
  kategori    String
  cariHesapId String?
  kasaBankaId String?
  createdBy   String?
  deletedAt   DateTime?
  deletedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
}

model KasaBanka {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ad        String
  tip       String // kasa | banka
  bakiye    Float    @default(0)
  paraCinsi String   @default("TRY")
  iban      String?
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model KrediKarti {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ad             String
  limit          Float    @default(0)
  borc           Float    @default(0)
  kartNo         String?
  sonOdemeTarihi String?
  createdBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([tenantId])
}

model BirikimHesabi {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ad        String
  bakiye    Float    @default(0)
  paraCinsi String   @default("TRY")
  iban      String?
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model Cek {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kisiAd      String
  kesideci    String?
  tutar       Float
  vadeTarihi  String
  durum       String // bekleyen | tahsil_edilen | geciken
  tip         String // alacak | borc
  aciklama    String?
  cariHesapId String?
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
}

model Personel {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ad              String
  email           String?
  pozisyon        String
  departman       String
  cinsiyet        String // erkek | kadin
  maas            Float    @default(0)
  telefon         String?
  baslangicTarihi String
  odemeTarihi     Int      @default(1)
  sskPrim         Float    @default(0)
  yemekUcreti     Float    @default(0)
  yolUcreti       Float    @default(0)
  durum           String   @default("aktif") // aktif | izinli | pasif
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  hareketler PersonelHareket[]

  @@index([tenantId])
}

model PersonelHareket {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  personelId String
  personel   Personel @relation(fields: [personelId], references: [id], onDelete: Cascade)
  tarih      String
  saat       String
  tip        String // maas | avans | urun | ssk | yemek | yol | prim | ikramiye | izin | mesai | ek_odeme
  aciklama   String
  tutar      Float
  createdBy  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([tenantId])
  @@index([personelId])
}

model DuzenliOdeme {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ad             String
  kategori       String
  tutar          Float    @default(0)
  sabitTutar     Boolean  @default(true)
  periyot        String // aylik | haftalik | yillik
  odemeGunu      Int      @default(1)
  sonOdemeTarihi String?
  durum          String   @default("aktif") // aktif | pasif
  hatirlatmaGun  Int      @default(3)
  aciklama       String?
  createdBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([tenantId])
}

model EmanetPara {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kisiAd      String
  tutar       Float
  alisTarihi  String
  odemeTarihi String?
  durum       String   @default("aktif") // aktif | odendi
  aciklama    String?
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
}

model Hedef {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ad          String
  hedefTutar  Float    @default(0)
  mevcutTutar Float    @default(0)
  bitisTarihi String
  kategori    String
  durum       String   @default("aktif") // aktif | tamamlandi
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
}

model SistemLog {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tarih     String
  saat      String
  modul     String
  islem     String
  detay     String
  createdAt DateTime @default(now())

  @@index([tenantId])
}

// ─────────────────────────────────────────────
//  DEPO / ÜRÜN / MAĞAZA / SİPARİŞ
// ─────────────────────────────────────────────

model ProductCategory {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ad        String
  image     String?
  createdAt DateTime @default(now())

  @@index([tenantId])
}

model Marka {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ad        String
  aktif     Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([tenantId, ad])
  @@index([tenantId])
}

model VariationTemplate {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ad        String // ör. Beden, Renk
  values    Json // ["S","M","L"]
  createdAt DateTime @default(now())

  @@index([tenantId])
}

model LiveStream {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  status    String   @default("active") // active | ended
  baslik    String?
  startedAt DateTime @default(now())
  endedAt   DateTime?
  token     String?   @unique
  activeSatici String? // Canlı yayında seçili satıcı: yorumdan otomatik alınan siparişlere yazılır

  // Facebook canlı yayın yorum entegrasyonu
  fbVideoId String?
  fbToken   String?
  fbSince   DateTime?

  // Instagram canlı yayın yorum entegrasyonu
  igUserId  String?
  igToken   String?
  igSince   DateTime?

  orders LiveOrder[]

  @@index([tenantId])
}

model LiveOrder {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  streamId     String
  stream       LiveStream @relation(fields: [streamId], references: [id], onDelete: Cascade)
  user         String
  kod          String
  urun         String
  beden        String?
  productId    String?
  variation    String?
  saticiAd     String?
  durum        String // onaylandi | stok_yok | riskli | iptal
  tutar        Float    @default(0)
  alis         Float    @default(0)
  storeOrderId String?
  freeProductId String?
  supplierId   String?
  drop         Boolean  @default(false)
  teslimAlindi Boolean  @default(false)
  gorsel       String?
  commentId    String?  // IG/FB yorum kimliği — kalıcı tekilleştirme (pm2 restart sonrası çift sipariş engeli)
  createdAt    DateTime @default(now())

  @@index([tenantId])
  @@index([streamId])
  @@index([streamId, commentId])
  @@index([supplierId])
  @@index([tenantId, streamId, createdAt])
}

model BotConfig {
  id        String   @id @default(cuid())
  tenantId  String   @unique
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String   @default("Asistan")
  greeting  String   @default("Merhaba! Size nasıl yardımcı olabilirim?")
  persona   String   @default("")
  profil    String   @default("")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BotGap {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  anahtar   String
  ornek     String
  adet      Int      @default(1)
  cozuldu   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, anahtar])
  @@index([tenantId])
}

model BotKnowledge {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  soru      String
  cevap     String
  createdAt DateTime @default(now())

  @@index([tenantId])
}

model DestekTalebi {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  no        String   @default("")
  musteriAd String?
  customerId String?
  telefon   String?
  kategori  String?
  baslik    String
  konu      String?
  detay     String?
  gorseller Json?
  yanit     String?
  durum     String   @default("acik") // acik | islemde | yanitlandi | cozuldu | kapatildi
  kaynak    String   @default("manuel") // manuel | chatbot | musteri
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model NotificationSub {
  id         String   @id @default(cuid())
  tenantId   String
  customerId String?
  musteriAd  String?
  telefon    String?
  beden      String?
  kategori   String?
  ilgi       String?
  kaynak     String   @default("yeni_eklenenler")
  createdAt  DateTime @default(now())

  @@index([tenantId])
}

model ProductReview {
  id        String   @id @default(cuid())
  tenantId  String
  productId String
  customerId String?
  ad        String
  puan      Int      @default(5)
  yorum     String?
  gorsel    String?
  onayli    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([productId])
  @@index([customerId])
}

model TeamMessage {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String?
  ad        String
  content   String
  createdAt DateTime @default(now())

  @@index([tenantId])
}

model ProductView {
  id         String   @id @default(cuid())
  tenantId   String
  productId  String
  customerId String?
  createdAt  DateTime @default(now())

  @@index([tenantId])
  @@index([productId])
}

model SicilKaydi {
  id        String   @id @default(cuid())
  tenantId  String
  satici    String
  tip       String   // iade | yanlis_beden | sikayet | gecikme | olumlu | not
  aciklama  String?
  orderRef  String?
  createdAt DateTime @default(now())

  @@index([tenantId])
}

model ChatSession {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  musteriAd    String?
  musteriTipi  String? // yeni | mevcut
  instagram    String?
  telefon      String?
  pendingTicket Boolean @default(false)
  status       String   @default("open") // open | closed
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  messages ChatMessage[]

  @@index([tenantId])
}

model ChatMessage {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String // user | bot | agent
  content   String
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([sessionId])
}

model Product {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ad              String
  sku             String?
  salesCode       String?
  marka           String?
  cinsiyet        String   @default("unisex")
  kategoriId      String?
  alisFiyat       Float    @default(0)
  satisFiyat      Float    @default(0)
  kdv             Float    @default(10)
  eskiFiyat       Float?
  oneCikan        Boolean  @default(false)
  barkod          String?
  stokAdeti       Float    @default(0)
  aciklama        String?
  tedarikciAd     String?
  tedarikciBarkod String?
  lokasyon        String   @default("")
  images          Json? // ["url", ...] (max 5, ilki kapak)
  aktif           Boolean  @default(true)
  onlineMagaza    Boolean  @default(false)
  canliSatis      Boolean  @default(false)
  onSiparis       Boolean  @default(false)
  createdBy       String?
  kaynak          String? // dis kaynak etiketi (or. "sepetw")
  kaynakId        String? // dis kaynaktaki urun id'si (izlenebilirlik)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  variations ProductVariation[]

  @@index([tenantId])
  @@index([tenantId, kaynak, kaynakId])
}

model ProductVariation {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  ad        String // ör. Beden / Renk
  deger     String // ör. L / Kirmizi
  stok      Float    @default(0)
  ekFiyat   Float    @default(0)
  barkod    String?
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([productId])
}

model SalesCode {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code      String
  used      Boolean  @default(false)
  productId String?
  createdAt DateTime @default(now())

  @@unique([tenantId, code])
  @@index([tenantId])
}

model ImportJob {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider     String   @default("sepetw")
  status       String   @default("preview") // preview | committed | canceled
  salesChannel String   @default("all")
  totalItems   Int      @default(0)
  counts       Json? // { new, update, warn }
  rows         Json? // eslenmis satirlar (onizleme)
  result       Json? // { created, updated, skipped, failed }
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId, status])
}

model Customer {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ad        String
  telefon   String?
  telKey    String?
  email     String?
  instagram String?
  igKey     String?
  cinsiyet  String?
  adres     String?
  il        String?
  ilce      String?
  not       String?
