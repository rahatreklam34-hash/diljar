// ─── WhatsApp Paneli ──────────────────────────────────────────────────────────

// Bağlı WhatsApp hattı (Baileys QR oturumu)
model WhatsappLine {
  id             String    @id @default(cuid())
  tenantId       String
  label          String // panelde görünen ad (ör. "Hat 1")
  phone          String? // bağlandıktan sonra tespit edilen numara
  jid            String? // baileys jid
  status         String    @default("disconnected") // disconnected | connecting | qr | connected | logout
  channel        String    @default("qr") // qr (Baileys) | api (resmî Meta Cloud API)
  // --- Cloud API alanları (channel='api') ---
  wabaId         String? // WhatsApp Business Account ID
  phoneNumberId  String? // Cloud API Phone Number ID
  accessToken    String? // kalıcı erişim token (yanıtlarda maskelenir)
  apiVerified    Boolean   @default(false) // /me testi başarılı mı
  active         Boolean   @default(true) // açılışta otomatik bağlanmaya çalış
  gunlukLimit    Int       @default(0) // 0 = ayarlardaki varsayılan limit
  gonderimAralikSn Int     @default(0) // 0 = ayarlardaki global aralık
  sentDate       String? // "YYYY-MM-DD" — günlük sayaç tarihi
  sentToday      Int       @default(0)
  newChatDate    String? // "YYYY-MM-DD" — günlük YENİ SOHBET sayacı tarihi
  newChatToday   Int       @default(0) // bugün bu hattan başlatılan yeni sohbet (24sn'de mesajı olmayan müşteri) sayısı
  lastSentAt     DateTime?
  lastConnectedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([tenantId])
}

// Müşteri ↔ hat eşlemesi + sohbet özeti (sticky routing: bir müşteri tek hatta sabitlenir)
model WhatsappConversation {
  id            String   @id @default(cuid())
  tenantId      String
  lineId        String // bu müşteriyle ilk iletişime geçen / atanan hat
  customerPhone String // normalize edilmiş (90XXXXXXXXXX)
  customerName  String?
  customerId    String?
  lastMessageAt DateTime @default(now())
  lastPreview   String?
  lastDirection String? // in | out
  unread        Int      @default(0)
  closed        Boolean  @default(false) // sohbet kapatıldı mı (açık sohbet filtresi için)
  closedAt      DateTime?
  tags          String[] @default([]) // sohbet durum etiketleri (filtreleme için)
  note          String? // sohbetin üstüne tutturulan (pinned) müşteri notu
  windowExpiresAt DateTime? // Cloud API 24s müşteri hizmet penceresi bitişi (free-form için)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([tenantId, customerPhone])
  @@index([tenantId, lastMessageAt])
  @@index([tenantId, closed, lastMessageAt])
  @@index([lineId])
}

model WhatsappMessage {
  id             String   @id @default(cuid())
  tenantId       String
  conversationId String
  lineId         String
  customerPhone  String
  direction      String // in | out
  body           String
  mediaType      String? // image | document | audio | video
  mediaUrl       String?
  mediaMime      String? // gelen/giden medya MIME türü
  fileName       String? // belge adı
  waMediaId      String? // Cloud API gelen medya id (indirme için)
  templateName   String? // giden şablon mesajı ise şablon adı
  waMessageId    String?
  status         String   @default("sent") // queued | sent | delivered | read | failed
  error          String?
  reaction       String? // bu mesaja konmuş emoji tepkisi (bizim ya da müşterinin)
  deleted        Boolean  @default(false) // herkesten silindi / panelden gizlendi
  replyToWaId    String? // alıntılanan (yanıtlanan) mesajın WhatsApp id'si
  replyToText    String? // alıntı önizleme metni
  sentByName     String? // giden mesajı gönderen panel kullanıcısının adı
  createdAt      DateTime @default(now())

  @@index([conversationId, createdAt])
  @@index([tenantId, createdAt])
}

// Giden kuyruğu (throttle + günlük limit + sticky/dengeli dağıtım worker'ı bunu işler)
model WhatsappOutbox {
  id            String    @id @default(cuid())
  tenantId      String
  lineId        String? // null = worker dengeli/sticky seçsin
  customerPhone String
  body          String
  kind          String    @default("manual") // order | manual | auto | status | payment | bulk | template
  channel       String? // null/'api' = resmî Cloud API (varsayılan), 'qr' = kullanıcı panelden açıkça QR seçti
  status        String    @default("pending") // pending | sent | failed | skipped
  attempts      Int       @default(0)
  scheduledAt   DateTime  @default(now())
  sentAt        DateTime?
  error         String?
  orderId       String?
  // --- Cloud API / medya / kampanya ---
  templateId    String? // onaylı şablonla gönderilecekse
  templateVars  Json? // şablon değişken değerleri (sıralı dizi)
  mediaType     String? // image | document | audio | video
  mediaUrl      String? // gönderilecek medya (public URL)
  fileName      String?
  replyToWaId   String? // alıntılı (yanıt) gönderimde hedef WhatsApp mesaj id'si
  replyToText   String? // alıntı önizleme metni
  bulkJobId     String? // toplu mesaj kaydıysa
  sentByName    String? // mesajı kuyruğa ekleyen panel kullanıcısının adı
  createdAt     DateTime  @default(now())

  @@index([tenantId, status, scheduledAt])
  @@index([bulkJobId])
}

model WhatsappSettings {
  id                 String   @id @default(cuid())
  tenantId           String   @unique
  globalAralikSn     Int      @default(8) // hat başına ardışık gönderim min aralığı (sn)
  jitterSn           Int      @default(5) // 0..jitter rastgele ek gecikme
  lineDefaultLimit   Int      @default(200) // hat başına günlük varsayılan limit
  calismaSaatAktif   Boolean  @default(false)
  calismaBasla       String   @default("09:00")
  calismaBitis       String   @default("22:00")
  otoYanitAktif      Boolean  @default(false)
  otoYanitMetin      String?
  siparisBildirimAktif Boolean @default(true)
  siparisSablon      String   @default("Merhaba {ad}, {no} numaralı siparişiniz alındı. Toplam: {tutar} TL. Teşekkürler!")
  iptalAktif         Boolean  @default(true)
  iptalSablon        String   @default("Merhaba {ad}, {no} numaralı siparişiniz iptal edilmiştir. Bilginize.")
  stokAktif          Boolean  @default(true)
  stokSablon         String   @default("Merhaba {ad}, talep ettiğiniz {urun} ürününde stok yetersizliği oluştu. En kısa sürede sizi bilgilendireceğiz.")
  riskliAktif        Boolean  @default(false)
  riskliSablon       String   @default("Merhaba {ad}, siparişinizle ilgili teyit için sizinle iletişime geçeceğiz.")
  odemeAktif         Boolean  @default(true)
  odemeSablon        String   @default("Merhaba {ad}, {no} numaralı siparişinizin ödemesini şu linkten tamamlayabilirsiniz: {link}")
  // Ödeme onaylandı bildirimi (tahsilat tamamlandığında)
  odemeOnayAktif     Boolean  @default(true)
  odemeOnaySablon    String   @default("Merhaba {ad}, {tutar} tutarındaki ödemeniz başarıyla onaylanmıştır. Ödemeniz sistemimize işlenmiştir. Teşekkür eder, iyi alışverişler dileriz.")
  // Kargo hazırlık bildirimi (sepet hazırlanıyor durumuna alındığında)
  hazirlikAktif      Boolean  @default(true)
  hazirlikSablon     String   @default("Merhaba {ad}, Siparişiniz için gerekli kontroller tamamlanmıştır. Sepetiniz kargo hazırlık sürecine alınmıştır.")
  // --- Cloud API / webhook ---
  webhookVerifyToken String? // Meta webhook doğrulama token'ı (panel üretir)
  metaAppId          String? // Meta App ID (opsiyonel)
  metaAppSecret      String? // imza doğrulaması için (opsiyonel)
  apiFallbackBaileys Boolean  @default(true) // şablon onayı yokken QR hattından gönder
  // --- AI oto-yanıt ---
  aiAutoReplyAktif   Boolean  @default(false)
  aiPrompt           String? // AI'ya verilecek sistem talimatı / işletme bilgisi
  aiSadecePencereIci Boolean  @default(true) // yalnızca 24s pencere içinde otomatik yanıt ver
  hazirCevaplar      Json? // [{ id, baslik, metin, kategori, dil, kisayol, aktif, kullanim, sonKullanim }] hazır metin (quick reply)
  hazirKategoriler   Json? // ["Genel","Ödeme",...] hazır metin kategorileri
  sablonEslesme      Json? // { order, status, stok, iptal, riskli, payment } durum → onaylı şablon adı
  sabitSablonlar     Json? // ["tplId1","tplId2"] sohbet kutusuna sabitlenen onaylı şablon id'leri
  odemeHatirlatmaAktif    Boolean  @default(false) // ödeme yapmayanlara zamanlı toplu hatırlatma
  odemeHatirlatmaSaatleri Json? // ["10:00","15:00"] gün içi gönderim saatleri (HH:MM)
  ozelOtomasyonlar   Json? // [{ id, ad, tetikleyici, mesaj, aktif }] kullanıcı tanımlı otomasyonlar
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// Cloud API mesaj şablonları (Meta onayı gerektirir)
model WhatsappTemplate {
  id           String   @id @default(cuid())
  tenantId     String
  name         String // Meta şablon adı (küçük harf + _), tenant içinde benzersiz
  language     String   @default("tr")
  category     String   @default("UTILITY") // UTILITY | MARKETING | AUTHENTICATION
  headerType   String? // none | text | image | document
  headerText   String?
  bodyText     String // {{1}}, {{2}} ... değişkenli gövde
  footerText   String?
  buttonsJson  Json? // opsiyonel buton tanımları
  sampleJson   Json? // onay için örnek değişken değerleri
  varMap       Json? // {{n}} -> alan eşlemesi (ad/no/tutar/link/urun ...)
  status       String   @default("draft") // draft | pending | approved | rejected | disabled
  metaId       String? // Meta tarafındaki şablon id
  rejectReason String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, name, language])
  @@index([tenantId, status])
}

// Toplu mesaj kampanyaları (onaylı şablonla)
model WhatsappBulkJob {
  id           String   @id @default(cuid())
  tenantId     String
  templateId   String
  filterJson   Json? // hedef müşteri segment filtresi
  total        Int      @default(0)
  sent         Int      @default(0)
  failed       Int      @default(0)
  status       String   @default("queued") // queued | running | done | canceled
  createdBy     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId, status])
}

// Görsel workflow tanımı (sürükle-bırak akış editörü)
model WhatsappWorkflow {
  id            String   @id @default(cuid())
  tenantId      String
  ad            String
  triggerKind   String // order | status | payment_received | (yakında: cart_abandon, membership, ...)
  triggerFilter Json? // örn. { durum: "tamamlandi" } status tetikleyicisini daraltır
  graph         Json // { nodes:[{id,type,subtype,config,x,y}], edges:[{id,from,to,branch?}] }
  aktif         Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, triggerKind, aktif])
}

// Bir müşteri için çalışan workflow örneği (akıştaki konumu + bekleme durumu)
model WhatsappWorkflowRun {
  id            String    @id @default(cuid())
  tenantId      String
  workflowId    String
  customerPhone String
  orderId       String?
  currentNodeId String?
  status        String    @default("running") // running | waiting | done | failed | canceled
  wakeAt        DateTime? // delay düğümünde uyanma zamanı
  steps         Int       @default(0) // sonsuz döngü koruması
  context       Json? // { ad, no, tutar, link, urun, ... } değişken ikamesi
  converted     Boolean   @default(false) // dönüşüm-aksiyonuyla bitti (tamamlandı vb.)
  lastError     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([tenantId, status])
  @@index([status, wakeAt])
  @@index([workflowId])
}

// BirFatura entegrasyon ayarlari (token -> tenant cozumlemesi)
model BirFaturaAyar {
  id          String   @id @default(cuid())
  tenantId    String   @unique
  token       String   @unique
  aktif       Boolean  @default(true)
  indirimModu String   @default("DiscountAlanindan")
  kdvOrani    Float    @default(18)
  // Kategori bazlı varsayılan KDV: { "<kategoriId>": 10, ... }
  kategoriKdv Json?
  // Hangi sipariş durumlarında fatura kesilebilir (BirFatura'ya aktarılır)
  faturaDurumlari String[] @default(["kargoda"])
  // Fatura ayarları
  otomatikKesim     Boolean @default(false) // sipariş durum değişince otomatik aktar
  eFaturaTipi       String  @default("eArsiv") // eArsiv | eFatura
  faturaOnEki       String? // fatura seri/ön ek
  faturaAciklama    String? // fatura açıklama şablonu
  // Görünürlük & bildirim
  sepetteGoster     Boolean @default(true)  // sipariş/sepet detayında fatura bilgisi görünsün mü
  bildirimKesilince Boolean @default(true)  // fatura kesildiğinde bildirim
  bildirimBekleyen  Boolean @default(false) // bekleyen faturalar için hatırlatma
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([token])
}

// BirFatura tarafindan kesilen fatura kayitlari (faturalanmis siparis isaretleyici)
model BirFaturaFatura {
  id          String   @id @default(cuid())
  tenantId    String
  orderId     String
  sipNo       String?
  invoiceLink String?
  invoiceNo   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, orderId])
  @@index([tenantId])
}

// ───────── Etkileşim Ağı (sosyal medya hesap yönetim paneli) ─────────
// NOT: Bu modeller YALNIZCA veri/yönetim amaçlıdır. Gerçek otomasyon (canlı yayında
// otomatik yorum, proxy üzerinden oturum açma vb.) UYGULANMAZ; ToS ihlali ve kapsam dışıdır.
// proxy/persona/durum alanları sadece kayıt/yönetim için metin/enum alanlarıdır.
model SosyalHesap {
  id           String    @id @default(cuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  platform     String    @default("instagram")
  kullaniciAd  String
  profilFoto   String?
  durum        String    @default("aktif") // aktif | pasif | kullanilamaz
  proxy        String?
  proxyDurum   String?   @default("yok") // yok | aktif | pasif | hatali | test
  grupId       String?
  persona      String?
  etiketler    String? // virgülle ayrılmış veya JSON
  sonBaglanti  DateTime?
  sonIslem     String?
  cevrimici    Boolean   @default(false)
  notlar       String?
  createdAt    DateTime  @default(now())

  @@index([tenantId])
}

model SosyalGrup {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ad        String
  aciklama  String?
  createdAt DateTime @default(now())

  @@unique([tenantId, ad])
  @@index([tenantId])
}

model SosyalPersona {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ad        String
  aciklama  String?
  createdAt DateTime @default(now())

  @@unique([tenantId, ad])
  @@index([tenantId])
}

// ───────── Instagram Otomatik Yanit / Karsilama (sanal asistan) ─────────
// Resmi Meta Graph API (webhook + Send API) ile kendi Instagram Business hesabina
// gelen DM ve yorumlara otomatik yanit. Chrome/DOM otomasyonu YOK.
model IgOtoYanitKural {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tip             String   @default("dm") // dm | yorum
  anahtarKelimeler String? // virgul ile ayrilmis; bos = tum mesajlar / karsilama
  yanitMetni      String
  aktif           Boolean  @default(true)
  oncelik         Int      @default(0)
  createdAt       DateTime @default(now())

  @@index([tenantId])
}

model IgOtoAyar {
  id                   String   @id @default(cuid())
  tenantId             String   @unique
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  aktif                Boolean  @default(false)
  karsilamaAktif       Boolean  @default(true)
  karsilamaMetni       String?
  calismaSaatDisiAktif Boolean  @default(false)
  calismaSaatDisiMetni String?
  calismaBasSaat       String? // "09:00"
  calismaBitSaat       String? // "18:00"
  updatedAt            DateTime @updatedAt
}

model IgMesajLog {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  yon       String // in | out
  kanal     String   @default("dm") // dm | yorum
  gonderen  String?
  metin     String?
  kuralId   String?
  createdAt DateTime @default(now())

  @@index([tenantId])
}

// ───────── Etkileşim Ağı → Chrome eklentisi tabanlı cihaz (tarayıcı) yönetimi ─────────
// Her Cihaz = eklenti kurulu bir Chrome tarayıcısı. Panelden görev gönderilir; eklenti
// 3-5 sn'de bir poll ile görevi çeker, adımları (ac/yaz/tikla) yürütür, sonucu bildirir.
model Cihaz {
  id             String    @id @default(cuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ad             String
  aktivasyonKodu String    @unique
  baglandi       Boolean   @default(false) // aktivasyon kodu ile eşleşti mi
  grupId         String?
  etiketler      String? // virgülle ayrılmış
  cinsiyet       String? // kadin | erkek | unisex | cocuk
  ustBeden       String? // S | M | L | XL | XXL | XXXL | XXXXL
  altBeden       String? // rakamsal (30,31,32...)
  ayakkabiBeden  String? // rakamsal (38,39,40...)
  platform       String    @default("chrome")
  tarayiciBilgi  String? // userAgent
  cevrimici      Boolean   @default(false)
  sonGoruldu     DateTime?
  aktifSekmeUrl  String?
  durum          String    @default("aktif") // aktif | pasif
  notlar         String?
  createdAt      DateTime  @default(now())

  @@index([tenantId])
}

model CihazGrup {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ad        String
  aciklama  String?
  createdAt DateTime @default(now())

  @@unique([tenantId, ad])
  @@index([tenantId])
}

model CihazGorev {
  id        String            @id @default(cuid())
  tenantId  String
  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  baslik    String?
  hedefTip  String            @default("cihaz") // cihaz | grup | tumu
  hedefId   String? // grup id (hedefTip=grup)
  adimlar   Json // [{tip:'ac',url}|{tip:'yaz',selector,deger}|{tip:'tikla',selector}]
  durum     String            @default("beklemede") // beklemede | calisiyor | basarili | basarisiz | kismi | iptal
  olusturan String?
  createdAt DateTime          @default(now())
  sonuclar  CihazGorevSonuc[]

  @@index([tenantId])
}

model CihazGorevSonuc {
  id           String     @id @default(cuid())
  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  gorevId      String
  gorev        CihazGorev @relation(fields: [gorevId], references: [id], onDelete: Cascade)
  cihazId      String
  durum        String     @default("beklemede") // beklemede | calisiyor | basarili | basarisiz
  adimlar      Json? // cihaza özel adımlar (ör. etkileşim '<satisKodu> <beden>'); yoksa görevin adimlar'ı kullanılır
  mesaj        String?
  cekildiAt    DateTime?
  tamamlandiAt DateTime?
  createdAt    DateTime   @default(now())

  @@index([tenantId])
  @@index([gorevId])
  @@index([cihazId])
}
