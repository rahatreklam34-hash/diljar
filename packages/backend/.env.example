# ── Backend ortam değişkenleri ─────────────────────────────
# PostgreSQL bağlantısı
DATABASE_URL="postgresql://finanstakip:CHANGE_ME@localhost:5432/finanstakip?schema=public"

# Sunucu
PORT=3000
NODE_ENV=development

# JWT secret'ları (canlıda mutlaka rastgele uzun değerler kullanın)
JWT_SECRET="change-this-access-secret-min-32-chars"
JWT_REFRESH_SECRET="change-this-refresh-secret-min-32-chars"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="7d"

# Uygulama
APP_NAME="FinansTakip"
APP_DOMAIN="http://localhost:5173"
TRIAL_DAYS=7

# Dosya yükleme
UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB=10

# İlk süper admin (seed)
SEED_ADMIN_EMAIL="admin@diljar.com"
SEED_ADMIN_PASSWORD="Admin1234!"
SEED_ADMIN_NAME="Platform Yöneticisi"
